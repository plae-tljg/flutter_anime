{
  "name": "anime1.me",
  "baseUrl": "https://anime1.me",
  "animeListExtractor": {
    "type": "css",
    "selector": "ul li a",
    "attr": "href",
    "textField": "text"
  },
  "videoExtractor": {
    "strategy": "clickWaitExtract",
    "posterSelector": ".vjs-poster",
    "waitMs": 1000,
    "videoSelector": ".vjscontainer",
    "isolateVideo": true,
    "containerSelector": ".vjscontainer"
  }
}